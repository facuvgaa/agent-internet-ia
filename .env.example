# Credenciales AWS para Amazon Bedrock
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_SESSION_TOKEN=                          # opcional, solo si usás credenciales temporales
AWS_REGION=us-east-1

# Modelos (valores por defecto, opcional cambiar)
AWS_PRIMARY_LLM=anthropic.claude-3-haiku-20240307-v1:0
AWS_SECOND_LLM=us.anthropic.claude-sonnet-4-6

# APIs del backend (desarrollo local)
BACK_API=http://localhost:8080/api/v1/internet-ia
BACK_RETENTION_API=http://localhost:8080/api/v1/retention
BACK_SERVICE_API=http://localhost:8080/api/v1/available-services

CONVERSATION_DB=postgresql://admin-llm:admin-llm@localhost:5433/conversation-db

# Redis para checkpointer y ruteo
MEMORY_REDIS_URL=redis://localhost:6379
